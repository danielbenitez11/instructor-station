<Window x:Class="InstructorStation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InstructorStation.Wpf"
        mc:Ignorable="d"
        Title="Instructor Station" Height="450" Width="800">


    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Start" Command="{Binding StartCommand}" Width="80" Margin="0,0,10,0" />
            <Button Content="Pause" Command="{Binding PauseCommand}" Width="80" Margin="0,0,10,0" />
            <Button Content="Reset" Command="{Binding ResetCommand}" Width="80" Margin="0,0,10,0" />
        </StackPanel>
        <TextBlock FontSize="20" Text="{Binding State.AltitudeFt, StringFormat='Altitude: {0:F0} ft'}" />
        <TextBlock FontSize="20" Text="{Binding State.AirspeedKt, StringFormat='Airspeed: {0:F0} kt'}" />
        <TextBlock FontSize="20" Text="{Binding State.HeadingDeg, StringFormat='Heading: {0:F0} deg'}" />
        <TextBlock FontSize="20" Text="{Binding State.VerticalSpeedFpm, StringFormat='Vertical Speed: {0:F0} fpm'}" />
        <TextBlock FontSize="16" Margin="0,20,0,0" Text="{Binding Throttle, StringFormat='Throttle: {0:P0}'}" />
        <Slider Minimum="0" Maximum="1" Value="{Binding Throttle}" />
        <TextBlock FontSize="16" Margin="0,10,0,0" Text="{Binding PitchDeg, StringFormat='Pitch: {0:F0}°'}" />
        <Slider Minimum="-20" Maximum="20" Value="{Binding PitchDeg}" />
        <TextBlock FontSize="16" Margin="0,10,0,0" Text="{Binding BankDeg, StringFormat='Bank: {0:F0}°'}" />
        <Slider Minimum="-30" Maximum="30" Value="{Binding BankDeg}" />
    </StackPanel>
</Window>
